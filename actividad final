        "\n",
        "    with col2:\n",
        "        disponibles = [x for x in precios.columns if x != activo1]\n",
        "\n",
        "        activo2 = st.selectbox(\n",
        "            \"Segundo activo\",\n",
        "            disponibles,\n",
        "            format_func=lambda x: NOMBRES.get(x, x),\n",
        "            key=\"sim_activo_2\"\n",
        "        )\n",
        "\n",
        "    capital_sim = st.number_input(\n",
        "        \"Capital inicial (COP)\",\n",
        "        min_value=100000,\n",
        "        value=1000000,\n",
        "        step=100000,\n",
        "        key=\"sim_capital\"\n",
        "    )\n",
        "\n",
        "    distribucion = st.slider(\n",
        "        f\"Porcentaje destinado a {NOMBRES.get(activo1, activo1)}\",\n",
        "        0, 100, 50, 5,\n",
        "        key=\"sim_distribucion\"\n",
        "    )\n",
        "\n",
        "    peso1 = distribucion / 100\n",
        "    peso2 = 1 - peso1\n",
        "\n",
        "    c1, c2 = st.columns(2)\n",
        "\n",
        "    c1.metric(\n",
        "        NOMBRES.get(activo1, activo1),\n",
        "        f\"{distribucion}%\",\n",
        "        f\"$ {capital_sim * peso1:,.0f}\"\n",
        "    )\n",
        "\n",
        "    c2.metric(\n",
        "        NOMBRES.get(activo2, activo2),\n",
        "        f\"{100-distribucion}%\",\n",
        "        f\"$ {capital_sim * peso2:,.0f}\"\n",
        "    )\n",
        "\n",
        "    if st.button(\"🚀 Simular inversión a 12 meses\", type=\"primary\"):\n",
        "        historicos = precios[[activo1, activo2]].pct_change().dropna()\n",
        "\n",
        "        if len(historicos) < 30:\n",
        "            st.error(\"No hay suficientes datos históricos.\")\n",
        "        else:\n",
        "            rng = np.random.default_rng(42)\n",
        "\n",
        "            pesos = np.array([peso1, peso2])\n",
        "            medias = historicos.mean().values\n",
        "            covarianza = historicos.cov().values\n",
        "\n",
        "            escenarios = rng.multivariate_normal(\n",
        "                medias,\n",
        "                covarianza,\n",
        "                size=(500, 252)\n",
        "            )\n",
        "\n",
        "            escenarios = np.maximum(escenarios, -0.99)\n",
        "\n",
        "            rendimiento = np.sum(escenarios * pesos, axis=2)\n",
        "\n",
        "            trayectorias = capital_sim * np.cumprod(\n",
        "                1 + rendimiento,\n",
        "                axis=1\n",
        "            )\n",
        "\n",
        "            finales = trayectorias[:, -1]\n",
        "\n",
        "            conservador = np.percentile(finales, 10)\n",
        "            central = np.percentile(finales, 50)\n",
        "            favorable = np.percentile(finales, 90)\n",
        "\n",
        "            st.divider()\n",
        "            st.markdown(\"### 📊 Resultados proyectados\")\n",
        "\n",
        "            r1, r2, r3 = st.columns(3)\n",
        "\n",
        "            r1.metric(\n",
        "                \"Escenario conservador\",\n",
        "                f\"$ {conservador:,.0f}\",\n",
        "                f\"{conservador/capital_sim-1:+.2%}\"\n",
        "            )\n",
        "\n",
        "            r2.metric(\n",
        "                \"Escenario central\",\n",
        "                f\"$ {central:,.0f}\",\n",
        "                f\"{central/capital_sim-1:+.2%}\"\n",
        "            )\n",
        "\n",
        "            r3.metric(\n",
        "                \"Escenario favorable\",\n",
        "                f\"$ {favorable:,.0f}\",\n",
        "                f\"{favorable/capital_sim-1:+.2%}\"\n",
        "            )\n",
        "\n",
        "            st.markdown(\"### 📈 Evolución del capital\")\n",
        "\n",
        "            curva = pd.DataFrame({\n",
        "                \"Conservador\": np.percentile(trayectorias, 10, axis=0),\n",
        "                \"Central\": np.percentile(trayectorias, 50, axis=0),\n",
        "                \"Favorable\": np.percentile(trayectorias, 90, axis=0)\n",
        "            })\n",
        "\n",
        "            colores_esc = {\n",
        "                \"Conservador\": \"#f4c76b\",\n",
        "                \"Central\": \"#35e0ad\",\n",
        "                \"Favorable\": \"#71a7ff\"\n",
        "            }\n",
        "\n",
        "            fig_esc = px.line(curva, color_discrete_map=colores_esc)\n",
        "\n",
        "            fig_esc.update_traces(line=dict(width=3))\n",
        "\n",
        "            fig_esc.update_layout(\n",
        "                template=\"plotly_dark\",\n",
        "                paper_bgcolor=\"rgba(0,0,0,0)\",\n",
        "                plot_bgcolor=\"rgba(0,0,0,0)\",\n",
        "                font=dict(color=\"#ffffff\"),\n",
        "                height=400,\n",
        "                hovermode=\"x unified\",\n",
        "                legend_title_text=\"Escenario\",\n",
        "                legend=dict(orientation=\"h\", y=1.10, x=0),\n",
        "                xaxis=dict(title=\"Días bursátiles\", showgrid=False),\n",
        "                yaxis=dict(\n",
        "                    title=\"Capital (COP)\",\n",
        "                    gridcolor=\"rgba(255,255,255,.10)\"\n",
        "                )\n",
        "            )\n",
        "\n",
        "            etiquetar_lineas(fig_esc, curva, colores_esc)\n",
        "\n",
        "            st.plotly_chart(fig_esc, use_container_width=True)\n",
        "\n",
        "            st.markdown(\"### Comparación de escenarios\")\n",
        "\n",
        "            resultado = pd.DataFrame({\n",
        "                \"Escenario\": [\"Conservador\", \"Central\", \"Favorable\"],\n",
        "                \"Capital final\": [conservador, central, favorable],\n",
        "                \"Ganancia / pérdida\": [\n",
        "                    conservador-capital_sim,\n",
        "                    central-capital_sim,\n",
        "                    favorable-capital_sim\n",
        "                ]\n",
        "            })\n",
        "\n",
        "            st.dataframe(resultado, use_container_width=True)\n",
        "\n",
        "            st.info(\n",
        "                \"Simulación basada en 500 trayectorias y 252 días \"\n",
        "                \"bursátiles, utilizando rendimientos históricos. \"\n",
        "                \"No representa una predicción ni garantiza resultados. \"\n",
        "                \"No incluye comisiones, impuestos ni inflación.\"\n",
        "            )"
      ],
