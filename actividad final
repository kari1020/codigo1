        "\n",
        "def etiquetar_lineas(fig, df, colores, separacion=0.06):\n",
        "    \"\"\"Escribe el nombre de cada serie al final de su línea, con su mismo color.\"\"\"\n",
        "    ultimos = df.iloc[-1].sort_values()\n",
        "    rango = float(df.max().max() - df.min().min()) or 1.0\n",
        "    minimo = rango * separacion\n",
        "\n",
        "    posiciones = {}\n",
        "    previo = None\n",
        "\n",
        "    for nombre, valor in ultimos.items():\n",
        "        y = float(valor)\n",
        "        if previo is not None and y - previo < minimo:\n",
        "            y = previo + minimo   # evita que dos etiquetas se encimen\n",
        "        posiciones[nombre] = y\n",
        "        previo = y\n",
        "\n",
        "    for nombre, y in posiciones.items():\n",
        "        fig.add_annotation(\n",
        "            x=df.index[-1],\n",
        "            y=y,\n",
        "            xref=\"x\",\n",
        "            yref=\"y\",\n",
        "            text=f\"<b>{nombre}</b>\",\n",
        "            showarrow=False,\n",
        "            xanchor=\"left\",\n",
        "            xshift=8,\n",
        "            font=dict(color=colores.get(nombre, \"#ffffff\"), size=13)\n",
        "        )\n",
        "\n",
        "    fig.update_layout(margin=dict(r=140))\n",
        "\n",
        "st.sidebar.markdown(\"## 📊 FINLAB\")\n",
        "st.sidebar.caption(\"CENTRO DE ANÁLISIS FINANCIERO\")\n",
        "st.sidebar.divider()\n",
        "\n",
        "tickers = st.sidebar.multiselect(\n",
        "    \"Selecciona los activos\",\n",
        "    UNIVERSO,\n",
        "    default=UNIVERSO,\n",
        "    max_selections=3,\n",
        "    format_func=lambda x: NOMBRES[x]\n",
        ")\n",
        "\n",
        "capital = st.sidebar.number_input(\n",
        "    \"Capital inicial (COP)\",\n",
        "    min_value=100000,\n",
        "    value=1000000,\n",
        "    step=100000\n",
        ")\n",
        "\n",
        "st.sidebar.markdown(\"### Fuente de información\")\n",
        "\n",
        "fuente = st.sidebar.radio(\n",
        "    \"Selecciona una fuente\",\n",
        "    [\"Demostración\", \"Yahoo Finance\"],\n",
        "    index=0\n",
        ")\n",
        "\n",
        "consultar = False\n",
        "\n",
        "if fuente == \"Yahoo Finance\":\n",
        "    consultar = st.sidebar.button(\n",
        "        \"Consultar mercado\",\n",
        "        use_container_width=True\n",
        "    )\n",
        "\n",
        "st.sidebar.divider()\n",
        "st.sidebar.caption(\"FINLAB · Análisis financiero interactivo\")\n",
        "\n",
        "@st.cache_data(ttl=1800, show_spinner=False)\n",
        "def descargar_precios(simbolos):\n",
        "    datos = yf.download(\n",
        "        list(simbolos),\n",
        "        start=\"2021-01-01\",\n",
        "        auto_adjust=True,\n",
        "        progress=False,\n",
        "        threads=False,\n",
        "        timeout=8\n",
        "    )\n",
        "\n",
        "    if datos.empty:\n",
        "        raise ValueError(\"No se recibieron datos.\")\n",
        "\n",
        "    if isinstance(datos.columns, pd.MultiIndex):\n",
        "        cierre = datos[\"Close\"]\n",
        "    else:\n",
        "        cierre = datos[\"Close\"]\n",
        "\n",
        "    if isinstance(cierre, pd.Series):\n",
        "        cierre = cierre.to_frame(name=simbolos[0])\n",
        "\n",
        "    cierre = cierre.reindex(columns=list(simbolos))\n",
        "    cierre = cierre.sort_index().ffill().dropna()\n",
        "\n",
        "    if cierre.empty or len(cierre) < 30:\n",
        "        raise ValueError(\"Información insuficiente.\")\n",
        "\n",
        "    return cierre\n",
        "\n",
        "def simular_precios(simbolos):\n",
        "    rng = np.random.default_rng(23)\n",
        "    fechas = pd.bdate_range(\n",
        "        start=\"2021-01-01\",\n",
        "        end=\"2024-12-31\"\n",
        "    )\n",
        "\n",
        "    datos = {}\n",
        "\n",
        "    for i, ticker in enumerate(simbolos):\n",
        "        variacion = rng.normal(\n",
        "            0.0005 + i * 0.0001,\n",
        "            0.014 + i * 0.002,\n",
        "            len(fechas)\n",
        "        )\n",
        "\n",
        "        datos[ticker] = 100 * np.cumprod(1 + variacion)\n",
        "\n",
        "    return pd.DataFrame(datos, index=fechas)\n",
        "\n",
        "if not tickers:\n",
        "    st.warning(\"Selecciona al menos un activo en el panel lateral.\")\n",
