        "\n",
        "cartera = rendimientos.mean(axis=1)\n",
        "acumulado = (1 + cartera).cumprod()\n",
        "\n",
        "rendimiento_total = acumulado.iloc[-1] - 1\n",
        "volatilidad = cartera.std(ddof=1) * np.sqrt(252)\n",
        "valor_inversion = capital * acumulado\n",
