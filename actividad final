        "    st.stop()\n",
        "\n",
        "if precios is None or precios.empty:\n",
        "    st.stop()\n",
        "\n",
        "if simulados:\n",
        "    st.warning(\"MODO DEMOSTRACIÓN: los datos son simulados y no representan cotizaciones reales.\")\n",
